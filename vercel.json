{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/types/:slug",              "destination": "/type"              },
    { "source": "/character/:slug",          "destination": "/character"         },
    { "source": "/letters/:slug",            "destination": "/letter"            },
    { "source": "/vs/:slug",                 "destination": "/vs"                },
    { "source": "/compatibility/:pair",      "destination": "/compatibility-pair" },

    { "source": "/es/types/:slug",           "destination": "/es/type"           },
    { "source": "/es/character/:slug",       "destination": "/es/character"      },
    { "source": "/es/letters/:slug",         "destination": "/es/letter"         },
    { "source": "/es/vs/:slug",              "destination": "/es/vs"             },
    { "source": "/es/compatibility/:pair",   "destination": "/es/compatibility-pair" },

    { "source": "/pt/types/:slug",           "destination": "/pt/type"           },
    { "source": "/pt/character/:slug",       "destination": "/pt/character"      },
    { "source": "/pt/letters/:slug",         "destination": "/pt/letter"         },
    { "source": "/pt/vs/:slug",              "destination": "/pt/vs"             },
    { "source": "/pt/compatibility/:pair",   "destination": "/pt/compatibility-pair" },

    { "source": "/ja/types/:slug",           "destination": "/ja/type"           },
    { "source": "/ja/character/:slug",       "destination": "/ja/character"      },
    { "source": "/ja/letters/:slug",         "destination": "/ja/letter"         },
    { "source": "/ja/vs/:slug",              "destination": "/ja/vs"             },
    { "source": "/ja/compatibility/:pair",   "destination": "/ja/compatibility-pair" }
  ]
}
