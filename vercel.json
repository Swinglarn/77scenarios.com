{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/types/:slug",
      "destination": "/type"
    },
    {
      "source": "/letters/:slug",
      "destination": "/letter"
    },
    {
      "source": "/vs/:slug",
      "destination": "/vs"
    },
    {
      "source": "/compatibility/:pair",
      "destination": "/compatibility-pair"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://*.googlesyndication.com https://pagead2.googlesyndication.com https://*.doubleclick.net https://*.google.com https://adservice.google.com https://*.googleadservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.googlesyndication.com https://pagead2.googlesyndication.com https://*.doubleclick.net https://*.google.com; frame-src https://*.googlesyndication.com https://pagead2.googlesyndication.com https://*.doubleclick.net https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/store",
      "destination": "https://store.77scenarios.com",
      "permanent": true
    },
    {
      "source": "/character/th-oden-king",
      "destination": "/character/theoden-king",
      "permanent": true
    },
    {
      "source": "/character/beyonc",
      "destination": "/character/beyonce",
      "permanent": true
    },
    {
      "source": "/character/gabriel-garc-a-m-rquez",
      "destination": "/character/gabriel-garcia-marquez",
      "permanent": true
    },
    {
      "source": "/character/pel",
      "destination": "/character/pele",
      "permanent": true
    },
    {
      "source": "/character/slavoj-i-ek",
      "destination": "/character/slavoj-zizek",
      "permanent": true
    },
    {
      "source": "/character/edmond-dant-s",
      "destination": "/character/edmond-dantes",
      "permanent": true
    },
    {
      "source": "/character/sim-n-bol-var",
      "destination": "/character/simon-bolivar",
      "permanent": true
    },
    {
      "source": "/character/niccol-machiavelli",
      "destination": "/character/niccolo-machiavelli",
      "permanent": true
    },
    {
      "source": "/character/zlatan-ibrahimovi",
      "destination": "/character/zlatan-ibrahimovic",
      "permanent": true
    },
    {
      "source": "/character/am-lie-poulain",
      "destination": "/character/amelie-poulain",
      "permanent": true
    },
    {
      "source": "/character/fr-d-ric-chopin",
      "destination": "/character/frederic-chopin",
      "permanent": true
    }
  ]
}
