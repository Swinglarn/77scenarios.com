{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/types/:slug",
      "destination": "/type"
    },
    {
      "source": "/character/:slug",
      "destination": "/character"
    },
    {
      "source": "/letters/:slug",
      "destination": "/letter"
    },
    {
      "source": "/vs/:slug",
      "destination": "/vs"
    },
    {
      "source": "/compatibility/:pair",
      "destination": "/compatibility-pair"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://*.supabase.co https://77scenarios.com data:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://pagead2.googlesyndication.com; frame-src https://pagead2.googlesyndication.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/store",
      "destination": "https://store.77scenarios.com",
      "permanent": true
    },
    {
      "source": "/character/th-oden-king",
      "destination": "/character/theoden-king",
      "permanent": true
    },
    {
      "source": "/character/beyonc",
      "destination": "/character/beyonce",
      "permanent": true
    },
    {
      "source": "/character/gabriel-garc-a-m-rquez",
      "destination": "/character/gabriel-garcia-marquez",
      "permanent": true
    },
    {
      "source": "/character/pel",
      "destination": "/character/pele",
      "permanent": true
    },
    {
      "source": "/character/slavoj-i-ek",
      "destination": "/character/slavoj-zizek",
      "permanent": true
    },
    {
      "source": "/character/edmond-dant-s",
      "destination": "/character/edmond-dantes",
      "permanent": true
    },
    {
      "source": "/character/sim-n-bol-var",
      "destination": "/character/simon-bolivar",
      "permanent": true
    },
    {
      "source": "/character/niccol-machiavelli",
      "destination": "/character/niccolo-machiavelli",
      "permanent": true
    },
    {
      "source": "/character/zlatan-ibrahimovi",
      "destination": "/character/zlatan-ibrahimovic",
      "permanent": true
    },
    {
      "source": "/character/am-lie-poulain",
      "destination": "/character/amelie-poulain",
      "permanent": true
    },
    {
      "source": "/character/fr-d-ric-chopin",
      "destination": "/character/frederic-chopin",
      "permanent": true
    }
  ]
}
